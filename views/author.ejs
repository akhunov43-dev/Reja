<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio</title>
  <link rel="stylesheet" href="/main.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    rel="stylesheet" />
</head>

<body>
  <div class="frame">
    <div class="main_frame">

      <!-- ==========================================
           LEFT FRAME 
           ========================================== -->
      <div class="left_frame">

        <div class="left_1">
          <div class="left_1-1">
            <img src="./images/image2.jpg" class="profile-img" alt="profile">
          </div>
          <div class="left_1-2">
            <%= user.name %>
          </div>
          <div class="left_1-3">
            <%= user.profession %>
          </div>

          <div class="left_icons">
            <a class="link_href" href="#">
              <div class="icon"><img src="./icon/Facebook.svg" class="icon-1" /></div>
            </a>
            <a class="link_href" href="#">
              <div class="icon"><img src="./icon/Instagram.svg" class="icon-1" /></div>
            </a>
            <a class="link_href" href="#">
              <div class="icon"><img src="./icon/Twitter.svg" class="icon-1" /></div>
            </a>
            <a class="link_href" href="#">
              <div class="icon"><img src="./icon/Linkeding.svg" class="icon-1" /></div>
            </a>
            <a class="link_href" href="#">
              <div class="icon"><img src="./icon/Youtube.svg" class="icon-1" /></div>
            </a>
            <a class="link_href" href="#">
              <div class="icon"><img src="./icon/Dribbble.svg" class="icon-1" /></div>
            </a>
          </div>
        </div>
        <div class="marginer"></div>

        <div class="left_2">
          <div class="info_row">
            <span class="info_label">Age:</span>
            <span class="info_value">20</span>
          </div>
          <div class="info_row">
            <span class="info_label">Residence:</span>
            <span class="info_value">S.Korea</span>
          </div>
          <div class="info_row">
            <span class="info_label">Address:</span>
            <span class="info_value">S.Korea, Busan</span>
          </div>
        </div>
        <div class="marginer"></div>

        <div class="left_3">
          <h5 class="sidebar_title">Languages</h5>
          <div class="progress_item">
            <div class="progress_text"><span>Uzbek, English</span><span>100%</span></div>
            <div class="bar_container">
              <div class="bar_fill" style="width: 100%;"></div>
            </div>
          </div>
          <div class="progress_item">
            <div class="progress_text"><span>Korean</span><span>80%</span></div>
            <div class="bar_container">
              <div class="bar_fill" style="width: 80%;"></div>
            </div>
          </div>
        </div>
        <div class="marginer"></div>

        <div class="left_4">
          <h5 class="sidebar_title">Skills</h5>
          <div class="progress_item">
            <div class="progress_text"><span>Html, Css</span><span>90%</span></div>
            <div class="bar_container">
              <div class="bar_fill" style="width: 90%;"></div>
            </div>
          </div>
          <div class="progress_item">
            <div class="progress_text"><span>Json</span><span>95%</span></div>
            <div class="bar_container">
              <div class="bar_fill" style="width: 95%;"></div>
            </div>
          </div>
          <div class="progress_item">
            <div class="progress_text"><span>NodeJS</span><span>85%</span></div>
            <div class="bar_container">
              <div class="bar_fill" style="width: 85%;"></div>
            </div>
          </div>
          <div class="progress_item">
            <div class="progress_text"><span>Python</span><span>80%</span></div>
            <div class="bar_container">
              <div class="bar_fill" style="width: 80%;"></div>
            </div>
          </div>
        </div>
        <div class="marginer"></div>

        <div class="left_5">
          <h5 class="sidebar_title">Extra Skills</h5>
          <div class="extra_item"><i class="fa fa-clone"></i> <span>Bootstrap, Materialize</span></div>
          <div class="extra_item"><i class="fa fa-clone"></i> <span>Styling, Sass</span></div>
          <div class="extra_item"><i class="fa fa-clone"></i> <span>Django, Flask</span></div>
          <div class="extra_item"><i class="fa fa-clone"></i> <span>GIT Knowledge</span></div>
        </div>
        <div class="marginer"></div>

      </div> <!-- /left_frame -->

      <!-- ==========================================
           MIDDLE FRAME 
           ========================================== -->
      <div class="midd_frame">

        <div class="banner">
          <div class="banner_text">
            <h1>Doctor Neurologist in OHSU Hospital</h1>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit.
              Et, volutpat feugiat placerat lobortis. Natoque rutrum
              semper sed suspendisse nunc lectus.
            </p>
            <button class="hire_btn">HIRE ME <i class="fa fa-arrow-right"></i></button>
          </div>
          <div class="banner_img">
            <img src="./images/image1.png" alt="Profile">
          </div>
        </div>

        <div class="services_title">
          <h2>My Services</h2>
          <p>
            Amet Minim Mollit Non Deserunt Ullamco Est Sit Aliqua Dolor
            Do Amet Sint. Velit Officia Consequat Duis Enim Velit Mollit.
            Lorum Ipsum
          </p>
        </div>

        <div class="services_grid">

          <div class="services_grid">

            <!-- Web Development Card -->
            <div class="card">
              <div class="service_icon_box">
                <!-- Fixed: Pointed to btn_icon folder -->
                <img src="./btn_icon/coding.svg" class="service_img_icon" alt="Web Development Icon" />
              </div>
              <h3>Web Development</h3>
              <p>Blog, E-Commerce</p>
            </div>

            <!-- UI/UX Design Card -->
            <div class="card">
              <div class="service_icon_box">
                <img src="./btn_icon/illustration.svg" class="service_img_icon" alt="UI/UX Design Icon" />
              </div>
              <h3>UI/UX Design</h3>
              <p>Mobile App, Website Design</p>
            </div>

            <!-- Sound Design Card -->
            <div class="card">
              <div class="service_icon_box">
                <img src="./btn_icon/Microphone.svg" class="service_img_icon" alt="Sound Design Icon" />
              </div>
              <h3>Sound Design</h3>
              <p>Voice Over, Beat Making</p>
            </div>

            <!-- Game Design Card -->
            <div class="card">
              <div class="service_icon_box">
                <img src="./btn_icon/game-development.svg" class="service_img_icon" alt="Game Design Icon" />
              </div>
              <h3>Game Design</h3>
              <p>Character Design, Props & Objects</p>
            </div>

            <!-- Photography Card -->
            <div class="card">
              <div class="service_icon_box">
                <img src="./btn_icon/Photographer.svg" class="service_img_icon" alt="Photography Icon" />
              </div>
              <h3>Photography</h3>
              <p>Portrait, Product Photography</p>
            </div>

            <!-- Advertising Card -->
            <div class="card">
              <div class="service_icon_box">
                <!-- <img src="/btn_icon/illust.svg" class="service_img_icon" style="filter: hue-rotate(45deg);" alt="Advertising Icon" />--->
              </div>
              <h3>Advertising</h3>
              <p>Advertise your product</p>
            </div>

          </div>


        </div>


      </div> <!-- /midd_frame -->

      <!-- ==========================================
           RIGHT FRAME 
           ========================================== -->
      <div class="right_frame">
        <button class="theme_toggle">
          <img src="./icons2/Contrast.svg" class="toggle_svg" alt="Theme Toggle" />
        </button>

        <div class="nav_links">
          <a href="#" class="active"><img src="./icons2/Home.svg" alt="Home" class="nav-icon"></a>
          <a href="#"><img src="./icons2/Service.svg" alt="Services" class="nav-icon"></a>
          <a href="#"><img src="./icons2/Cv.svg" alt="CV" class="nav-icon"></a>
          <a href="#"><img src="./icons2/Portfolio.svg" alt="Portfolio" class="nav-icon"></a>
          <a href="#"><img src="./icons2/Blog.svg" alt="Blog" class="nav-icon"></a>
          <a href="#"><img src="./icons2/Contact.svg" alt="Contact" class="nav-icon"></a>
        </div>


      </div>

    </div> <!-- /main_frame -->
  </div> <!-- /frame -->
</body>

</html>