<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>REJA</title>
  <link rel="stylesheet"
    href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
    integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS"
    crossorigin="anonymous" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #dde1ea;
      --text: #2e3440;
      --text-muted: #6b7280;
      --accent: #4a90e2;
      --danger: #e0554f;
      --shadow-light: #ffffff;
      --shadow-dark: #b3b8c6;
    }

    * { font-family: 'Inter', -apple-system, sans-serif; }

    body {
      background-color: var(--bg) !important;
      color: var(--text);
      min-height: 100vh;
      padding-bottom: 4rem;
    }

    h1.display-4 {
      font-weight: 500;
      font-size: 2.25rem;
      letter-spacing: 0.5px;
      color: var(--text);
      margin: 2.5rem 0 2rem;
    }

    .jumbotron {
      background-color: var(--bg) !important;
      border: none;
      border-radius: 20px !important;
      box-shadow: 8px 8px 16px var(--shadow-dark), -8px -8px 16px var(--shadow-light) !important;
    }

    #create-field {
      background-color: var(--bg);
      border: none;
      color: var(--text);
      border-radius: 30px !important;
      height: 48px;
      padding: 0 20px;
      box-shadow: inset 4px 4px 8px var(--shadow-dark), inset -4px -4px 8px var(--shadow-light);
    }
    #create-field:focus {
      background-color: var(--bg);
      color: var(--text);
      box-shadow: inset 4px 4px 8px var(--shadow-dark), inset -4px -4px 8px var(--shadow-light);
    }
    #create-field::placeholder { color: var(--text-muted); }

    .btn-primary {
      background-color: var(--accent) !important;
      border: none !important;
      color: #fff !important;
      font-weight: 500;
      border-radius: 30px !important;
      padding: 0.65rem 1.5rem;
      box-shadow: 4px 4px 10px var(--shadow-dark), -4px -4px 10px var(--shadow-light);
      transition: transform 0.15s ease;
    }
    .btn-primary:hover { transform: translateY(-1px); }
    .btn-primary:active { transform: translateY(0); }

    #item-list { margin-top: 1.75rem; }

    .list-group-item {
      background-color: var(--bg) !important;
      border: none !important;
      color: var(--text);
      border-radius: 16px !important;
      margin-bottom: 12px;
      padding: 1rem 1.2rem;
      box-shadow: 5px 5px 12px var(--shadow-dark), -5px -5px 12px var(--shadow-light);
    }

    .item-text {
      font-size: 0.95rem;
      color: var(--text);
    }

    .btn-secondary {
      background-color: var(--bg) !important;
      border: none !important;
      color: var(--text-muted) !important;
      border-radius: 20px !important;
      font-weight: 500;
      box-shadow: 3px 3px 6px var(--shadow-dark), -3px -3px 6px var(--shadow-light);
    }
    .btn-secondary:hover { color: var(--text) !important; }

    .btn-danger {
      background-color: var(--danger) !important;
      border: none !important;
      color: #fff !important;
      border-radius: 20px !important;
      font-weight: 500;
      box-shadow: 3px 3px 6px var(--shadow-dark), -3px -3px 6px var(--shadow-light);
    }
    .btn-danger:hover { opacity: 0.9; }

    #clear-all {
      display: block;
      margin: 1.5rem auto 0;
      padding: 0.75rem 2rem;
      border-radius: 30px !important;
      box-shadow: 5px 5px 12px var(--shadow-dark), -5px -5px 12px var(--shadow-light) !important;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1 class="display-4 text-center py-1">REJA VA MAQSADLAR</h1>

    <div class="jumbotron p-3 shadow-sm">
      <form id="create-form" action="/create-item" method="POST">
        <div class="d-flex align-items-center">
          <input
            id="create-field"
            name="reja"
            autofocus
            autocomplete="off"
            class="form-control mr-3"
            type="text"
            placeholder="Reja qo'shish..."
            style="flex: 1"
          />
          <button class="btn btn-primary">
            Yangi Reja Qo'shish
          </button>
        </div>
      </form>
    </div>

    <ul id="item-list" class="list-group pb-5">
      <% items.map(function(item) { %>
        <li class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
          <span class="item-text"><%= item.reja %></span>
          <div>
            <button data-id="<%= item._id %>" class="edit-me btn btn-secondary btn-sm mr-1">O'zgartirish</button>
            <button data-id="<%= item._id %>" class="delete-me btn btn-danger btn-sm">O'chirish</button>
          </div>
        </li>
      <% }) %>
    </ul>

    <button id="clear-all" class="btn btn-danger">
      Hamma Rejalarni O'chirish
    </button>
  </div>

  <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
  <script src="/browser.js"></script>
</body>
</html>